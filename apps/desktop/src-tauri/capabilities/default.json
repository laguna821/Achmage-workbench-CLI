{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The workbench UI is served by the local gateway on 127.0.0.1; session windows (\"새 창으로 떼어 내기\") show the same UI.",
  "windows": [
    "main",
    "session-*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "obsidian://*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        }
      ]
    },
    "notification:default",
    "allow-open-session-window",
    "allow-notify-session",
    "allow-set-attention",
    "allow-render-svg-pdf",
    "allow-print-svg",
    "allow-render-html-pdf",
    "allow-print-html",
    "allow-office-cli-job",
    "allow-office-cli-write",
    "allow-office-cli-done",
    "allow-office-browser"
  ]
}
