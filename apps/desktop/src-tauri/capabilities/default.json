{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The workbench UI is served by the local gateway on 127.0.0.1.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
