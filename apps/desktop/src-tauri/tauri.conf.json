{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Achmage Workbench",
  "mainBinaryName": "achmage-workbench",
  "version": "0.1.0",
  "identifier": "kr.achmage.workbench",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "node -e \"require('node:fs').rmSync('src-tauri/target/release/web', { recursive: true, force: true })\""
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Development",
    "shortDescription": "Claude Code와 Codex를 한 화면에서 쓰는 작업실",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": {
      "../../host/dist/host.mjs": "host/host.mjs",
      "../../web/dist/": "web/"
    },
    "linux": { "appimage": { "bundleMediaFramework": false } }
  }
}
