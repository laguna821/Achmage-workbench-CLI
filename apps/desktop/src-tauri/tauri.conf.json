{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Achmage Workbench",
  "mainBinaryName": "achmage-workbench",
  "version": "0.4.1",
  "identifier": "kr.achmage.workbench",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "node scripts/clean-web.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Development",
    "shortDescription": "Claude Code와 Codex를 한 화면에서 쓰는 작업실",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../host/dist/": "host/",
      "../../web/dist/": "web/",
      "../../../third_party/office-output/": "licenses/office-output/",
      "../../../third_party/paseo/": "licenses/paseo/",
      "../../../third_party/fast-find/LICENSE": "licenses/fast-find/LICENSE",
      "../../../third_party/fast-find/ADAPTATIONS.md": "licenses/fast-find/ADAPTATIONS.md",
      "../../../third_party/skills/": "skills/",
      "../../../third_party/voice/": "licenses/voice/",
      "../../../third_party/extensions/": "licenses/extensions/",
      "../../../third_party/agent-desktop/": "licenses/agent-desktop/"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
