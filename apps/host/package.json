{
  "name": "@workbench/host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/host.mjs --log-level=warning --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\""
  },
  "dependencies": {
    "@workbench/contracts": "0.1.0",
    "@workbench/provider-codex": "0.1.0",
    "@workbench/provider-claude": "0.1.0"
  }
}
