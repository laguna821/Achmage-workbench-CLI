+/// [Ieum patch 0020] A paper-anchored TopAndBottom box whose anchor line (and every later one) is
+/// stored as if the box were not there, with a stale restart where that shorter layout ended page 1.
+/// Fixture: IeumOffice `apps/hwp/tests/fixtures/paper-topbottom-box-stale-ladder.hwpx` (saved by
+/// Hangul 2024, then its stored positions moved). Hangul 2024 draws the anchor paragraph and all
+/// that follows below the box, the inline table too, fills page 1 with 32 filler lines and puts the
+/// other 18 on page 2 (Ieum vitest "starts what follows a paper-anchored top-and-bottom box below it").
+#[cfg(test)]
+mod ieum_0020_tests {
+    fn boxes(node: &serde_json::Value, out: &mut Vec<(String, i64, f64, f64)>) {
+        let kind = node["type"].as_str().unwrap_or_default().to_string();
+        let owned = node["pi"].as_i64().is_some_and(|pi| pi < 1_000_000_000)
+            && node["bbox"].is_object();
+        if owned && ["Table", "Image", "TextLine"].contains(&kind.as_str()) {
+            let y = node["bbox"]["y"].as_f64().unwrap();
+            out.push((kind.clone(), node["pi"].as_i64().unwrap(), y, y + node["bbox"]["h"].as_f64().unwrap()));
+        }
+        if kind != "Table" {
+            for child in node["children"].as_array().into_iter().flatten() {
+                boxes(child, out);
+            }
+        }
+    }
+
+    #[test]
+    fn ieum_0020_paper_topbottom_box_moves_its_anchor_and_what_follows_below_it() {
+        let bytes = include_bytes!("typeset/testdata/ieum-0020-paper-topbottom-box-stale-ladder.hwpx");
+        assert_moves_below_the_box(bytes);
+    }
+
+    /// [Workbench, H4b review M1] The same fixture with ONLY the anchor paragraph's empty run given
+    /// three spaces (`<hp:t>   </hp:t>`): an anchor that looks empty is laid out as the empty one
+    /// (before the fix: 17 lines on page 2, as a text anchor).
+    #[test]
+    fn ieum_0020_space_only_anchor_is_laid_out_as_the_empty_one() {
+        let bytes = include_bytes!("typeset/testdata/ieum-0020-paper-topbottom-box-space-anchor.hwpx");
+        assert_moves_below_the_box(bytes);
+    }
+
+    fn assert_moves_below_the_box(bytes: &[u8]) {
+        let doc = crate::wasm_api::HwpDocument::from_bytes(bytes).unwrap();
+        assert_eq!(doc.page_count(), 2);
+        let tree = |page| -> serde_json::Value {
+            serde_json::from_str(&doc.get_page_render_tree(page).unwrap()).unwrap()
+        };
+        let first = tree(0);
+        let children = first["children"].as_array().unwrap();
+        let rect = |node: &serde_json::Value, key: &str| node["bbox"][key].as_f64().unwrap();
+        let body = children.iter().find(|c| c["type"] == "Body").unwrap();
+        let body_bottom = rect(body, "y") + rect(body, "h");
+        let the_box = children
+            .iter()
+            .find(|c| c["type"] == "Rect" && rect(c, "w") > rect(body, "w") / 2.0)
+            .expect("wide box");
+        let box_bottom = rect(the_box, "y") + rect(the_box, "h");
+        let mut page = Vec::new();
+        boxes(&first, &mut page);
+        page.retain(|b| b.1 > 0);
+        page.sort_by(|a, b| a.2.total_cmp(&b.2));
+        assert!(page.iter().any(|b| b.0 == "Table" && b.1 == 4));
+        for b in &page {
+            assert!(b.2 >= box_bottom - 0.5, "{b:?} starts inside the box (bottom {box_bottom})");
+            assert!(b.3 <= body_bottom + 0.5, "{b:?} runs below the body ({body_bottom})");
+        }
+        for pair in page.windows(2) {
+            assert!(pair[1].2 >= pair[0].3 - 0.5, "{:?} overlaps {:?}", pair[1], pair[0]);
+        }
+        // The anchor's own line sits below the box, so the first title line starts one line lower.
+        let title = page.iter().find(|b| b.1 == 2).unwrap();
+        assert!(title.2 > box_bottom + 10.0, "title line at {} (box bottom {box_bottom})", title.2);
+        let mut second = Vec::new();
+        boxes(&tree(1), &mut second);
+        let lines: Vec<_> = second.iter().filter(|b| b.0 == "TextLine").collect();
+        assert_eq!(lines.len(), 18, "page 2 holds the last 18 filler lines: {lines:?}");
+        assert!(lines.iter().all(|b| b.3 <= body_bottom + 0.5));
+    }
+
+    /// [H4b] A paragraph WITH text that anchors a page-high top-and-bottom frame keeps the lines
+    /// Hangul stored inside the frame's band. samples/issue5941 roadmap: the independent Hancom
+    /// print has 302 pages (upstream `issue_7445_roadmap_source_fragment_ownership` asserts the
+    /// same); moving that anchor below its frame made page 158 hold 10 lines fewer (303 pages).
+    /// The sample is not part of the engine build's checkout; the test needs a full one.
+    #[test]
+    fn ieum_0020_text_anchor_keeps_its_stored_lines_roadmap_302_pages() {
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("samples/issue5941/1490000-201600081_roadmap_research.hwp");
+        let bytes = std::fs::read(&path).expect("samples/issue5941 roadmap (a full checkout)");
+        let doc = crate::wasm_api::HwpDocument::from_bytes(&bytes).unwrap();
+        assert_eq!(doc.page_count(), 302, "Hancom prints 302 pages");
+    }
+}
