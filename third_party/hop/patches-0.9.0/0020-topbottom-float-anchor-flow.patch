         exclusion_probe_height,
         absorbed_spacing_before,
diff --git a/src/renderer/typeset/state/transition.rs b/src/renderer/typeset/state/transition.rs
index 279ca706..aeb6726c 100644
--- a/src/renderer/typeset/state/transition.rs
+++ b/src/renderer/typeset/state/transition.rs
@@ -422,6 +422,92 @@ impl TypesetState {
             });
     }
 
+    /// [Ieum patch 0020] 종이·쪽 기준 자리차지(TopAndBottom) 도형·그림을 앵커한 문단이 그
+    /// 개체 밴드 안에서 시작하면, 한글 2024 는 앵커 문단부터 개체 아래에 놓는다. 위
+    /// `register_page_anchored_topbottom_band` 는 앵커 문단을 배치한 뒤(개체를 방출할 때)에야
+    /// 밴드를 등록하므로 뒤 문단만 밴드 아래로 갔고, 저장 사다리가 개체를 계상하지 않은
+    /// 문서(앵커 줄이 개체 안쪽에 저장됨)에서는 앵커 줄이 개체 안에 남아 뒤 흐름이 한 줄 위였다
+    /// (한글 2024: 1쪽 채움 줄 32 · 2쪽 18, rhwp: 33 · 17).
+    /// (0.9.0: the 0.8.7 form added its own geometry (`topbottom_float_anchor_flow_bottom`) and a
+    /// separate flow alignment; upstream's #7696 band now owns that geometry, so this only registers
+    /// the anchor's own bands before its fit. The fit's band probe
+    /// (`apply_visible_float_exclusions_absorbing`) then moves it and records
+    /// `page_band_flow_starts`, which layout consumes — no second flow owner. A band reaching the
+    /// body bottom (full-page cover) is not registered early: the anchor stays on this page with its
+    /// object, as in the 0.8.7 form.)
+    pub(in crate::renderer::typeset) fn register_anchor_own_page_topbottom_bands(
+        &mut self,
+        para_index: usize,
+        para: &Paragraph,
+        anchor_text_height: f64,
+    ) {
+        if self.data.col_count != 1 {
+            return;
+        }
+        let column = self.inline_flow_column();
+        let paper = crate::renderer::page_layout::LayoutRect {
+            x: 0.0,
+            y: 0.0,
+            width: self.data.layout.page_width,
+            height: self.data.layout.page_height,
+        };
+        let frame = crate::renderer::float_placement::ObjectPlacementFrame {
+            container: &column,
+            column: &column,
+            body: &self.data.layout.body_area,
+            paper: &paper,
+            paragraph_y: column.y,
+            alignment: crate::model::style::Alignment::Left,
+            dpi: self.data.layout.dpi,
+        };
+        let body_bottom = self.base_available_height();
+        let all: Vec<(f64, f64)> = para
+            .controls
+            .iter()
+            .filter_map(|control| frame.page_anchored_topbottom_band(control))
+            .map(|(top, bottom)| (top - column.y, bottom - column.y))
+            .collect();
+        // [H4b] Only an anchor paragraph WITHOUT visible text (it holds the object, as in Ieum's
+        // Hangul 2024 fixture) starts below its object. A paragraph with text whose stored lines
+        // Hangul laid inside the object's band keeps them there: samples/issue5941 roadmap
+        // (Hancom print 302 pages) has an 11-line paragraph anchoring a page-high frame; moved
+        // below the frame it pushed 10 lines to the next page (303 pages). Also the two
+        // conditions of the 0.8.7 form the first port dropped: the object's top is in the upper
+        // third of the column, and the anchor's lines do not fit between the flow and the first
+        // object's top. [Workbench, H4b review M1] "Visible text" is a character that is not white
+        // space and not a control: an anchor holding only spaces (U+0020, U+3000, U+00A0 …) looks
+        // empty and is laid out as the empty one (the shared `para_has_visible_text` counts a space).
+        if para
+            .text
+            .chars()
+            .any(|c| !c.is_whitespace() && !c.is_control() && c != '\u{FFFC}')
+        {
+            return;
+        }
+        if all
+            .first()
+            .is_some_and(|&(top, _)| anchor_text_height + 4.0 <= top - self.data.current_height)
+        {
+            return;
+        }
+        let bands: Vec<(f64, f64)> = all
+            .into_iter()
+            .filter(|&(top, _)| top <= column.height / 3.0)
+            .filter(|&(_, bottom)| {
+                bottom > self.data.current_height + 0.5 && bottom < body_bottom - 0.5
+            })
+            .collect();
+        for (top, bottom) in bands {
+            self.data
+                .page_anchored_bands
+                .push(crate::renderer::typeset::VisibleFloatExclusion {
+                    para_index,
+                    top,
+                    bottom,
+                });
+        }
+    }
+
