+/// IeumOffice patch 0003 (0.9.0 form): a visible body line drawn below the top of the
+/// footnote area pushes that area down, never past the footer band's bottom.
+#[test]
+fn ieum_0003_footnote_area_lowered_below_overlapping_body_line() {
+    fn run(id: NodeId, text: &str, bbox: BoundingBox) -> RenderNode {
+        RenderNode::new(
+            id,
+            RenderNodeType::TextRun(crate::renderer::render_tree::TextRunNode {
+                text: text.to_owned(),
+                style: TextStyle::default(),
+                char_shape_id: None,
+                para_shape_id: None,
+                section_index: None,
+                para_index: None,
+                char_start: None,
+                cell_context: None,
+                is_para_end: false,
+                is_line_break_end: false,
+                rotation: 0.0,
+                is_vertical: false,
+                char_overlap: None,
+                border_fill_id: 0,
+                baseline: 0.0,
+                field_marker: crate::renderer::render_tree::FieldMarkerType::None,
+                layout_positions: None,
+                display_text: None,
+            }),
+            bbox,
+        )
+    }
+    let page_def = PageDef {
+        width: 59528,
+        height: 84188,
+        margin_left: 8504,
+        margin_right: 8504,
+        margin_top: 5669,
+        margin_bottom: 4252,
+        margin_header: 4252,
+        margin_footer: 4252,
+        ..Default::default()
+    };
+    let layout = PageLayoutInfo::from_page_def_default(
+        &page_def,
+        &ColumnDef {
+            column_count: 1,
+            ..Default::default()
+        },
+    );
+    let body = layout.body_area;
+    let area_y = body.y + body.height - 40.0;
+    let build = |line_text: &str| {
+        let mut root = RenderNode::new(0, RenderNodeType::Column(0), BoundingBox::default());
+        let mut body_node = RenderNode::new(1, RenderNodeType::Body { clip_rect: None }, BoundingBox::new(body.x, body.y, body.width, body.height));
+        let line_box = BoundingBox::new(body.x, area_y - 10.0, body.width, 20.0);
+        let mut line = RenderNode::new(2, RenderNodeType::TextLine(crate::renderer::render_tree::TextLineNode::new(20.0, 16.0)), line_box);
+        line.children.push(run(3, line_text, line_box));
+        body_node.children.push(line);
+        root.children.push(body_node);
+        root.children.push(RenderNode::new(4, RenderNodeType::FootnoteArea, BoundingBox::new(body.x, area_y, body.width, 40.0)));
+        root
+    };
+    let mut root = build("본문");
+    LayoutEngine::lower_footnote_area_below_body(&mut root, &layout);
+    let moved = root.children[1].bbox.y;
+    assert!((moved - (area_y + 10.0)).abs() < 0.01, "area moved to the line bottom: {moved}");
+    // A line with no visible text does not move it.
+    let mut blank = build("   ");
+    LayoutEngine::lower_footnote_area_below_body(&mut blank, &layout);
+    assert!((blank.children[1].bbox.y - area_y).abs() < 0.01);
+}
