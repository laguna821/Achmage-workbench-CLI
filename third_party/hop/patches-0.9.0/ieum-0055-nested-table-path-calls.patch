+/// The stored-line part of `move_tac_host_row` on one paragraph list (the body, a cell or a
+/// text box): when the stored line of `paragraphs[para_idx]` holds the treat-as-char table
+/// `control_idx` at `declared` height, gives that line the `content` height, moves the later
+/// lines and the following paragraphs of the same stored flow by the difference and sets the
+/// table height. Returns the following paragraphs it moved, or None when nothing changed.
+pub(crate) fn move_host_row(
+    paragraphs: &mut [Paragraph],
+    para_idx: usize,
+    control_idx: usize,
+    declared: i64,
+    content: i64,
+) -> Option<Vec<usize>> {
+    let para = paragraphs.get(para_idx)?;
+    let Some(Control::Table(table)) = para.controls.get(control_idx) else {
+        return None;
+    };
+    if !table.common.treat_as_char
+        || table.caption.is_some()
+        || table.common.height == 0
+        || declared <= 0
+    {
+        return None;
+    }
+    // 표 외곽 상자 전체가 그 줄의 글자 높이일 때만 표가 그 저장 줄을 소유한다.
+    let row = control_line_seg_index(para, control_idx)?;
+    let seg = para.line_segs.get(row)?;
+    let old_band =
+        declared + i64::from(table.outer_margin_top) + i64::from(table.outer_margin_bottom);
+    if seg.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0 || i64::from(seg.text_height) != old_band
+    {
+        return None;
+    }
+    let delta = content - declared;
+    if delta.abs() <= ROUNDING_HU || content <= 0 {
+        return None;
+    }
+    let (Ok(content), Ok(delta), Ok(old_band)) = (
+        u32::try_from(content),
+        i32::try_from(delta),
+        i32::try_from(old_band),
+    ) else {
+        return None;
+    };
+    let new_band = old_band.saturating_add(delta);
+    let old_end = paragraph_flow_end(para);
+
+    let para = &mut paragraphs[para_idx];
+    if let Some(Control::Table(table)) = para.controls.get_mut(control_idx) {
+        table.sync_ctrl_height(content);
+    }
+    for (index, seg) in para.line_segs.iter_mut().enumerate() {
+        // 한컴은 문단의 모든 줄 line_height에 가장 높은 줄 높이를 적는다.
+        if seg.line_height == old_band {
+            seg.line_height = new_band;
+        }
+        if index == row {
+            seg.text_height = new_band;
+            seg.baseline_distance = ((i64::from(seg.baseline_distance) * i64::from(new_band)
+                + i64::from(old_band) / 2)
+                / i64::from(old_band)) as i32;
+        } else if index > row {
+            seg.vertical_pos = seg.vertical_pos.saturating_add(delta);
+        }
+    }
+    shift_source_positions(para, row + 1, delta);
+    Some(shift_following(paragraphs, para_idx + 1, old_end, delta))
+}
