+#[test]
+fn cell_sizes_reach_the_named_table() {
+    for (name, mut doc, para, path, above) in cases() {
+        let widths_above: Vec<_> = above
+            .iter()
+            .map(|p| {
+                table(&doc, para, p)
+                    .cells
+                    .iter()
+                    .map(|c| c.width)
+                    .collect::<Vec<_>>()
+            })
+            .collect();
+        let before = table(&doc, para, &path).cells[0].width;
+        let answer = json(
+            &doc.resize_table_cell_by_path_native(0, para, &path, 0, 0, false, false)
+                .expect("resize"),
+        );
+        assert_eq!(answer["moved"].as_bool(), Some(true), "{name}");
+        assert_eq!(
+            table(&doc, para, &path).cells[0].width,
+            before - 283,
+            "{name}"
+        );
+
+        let t = table(&doc, para, &path);
+        let (a, b) = (t.cells[0].width as i64, t.cells[1].width as i64);
+        let half = (a + b) / 2;
+        let extents = format!(
+            r#"[{{"cellIdx":0,"start":0,"end":{half}}},{{"cellIdx":1,"start":{half},"end":{}}},{{"cellIdx":2,"start":0,"end":{half}}},{{"cellIdx":3,"start":{half},"end":{}}}]"#,
+            a + b,
+            a + b
+        );
+        json(
+            &doc.set_table_cell_extents_by_path_native(0, para, &path, false, &extents)
+                .expect("extents"),
+        );
+        let t = table(&doc, para, &path);
+        assert_eq!(t.cells[0].width as i64, half, "{name}: equal widths");
+        assert_eq!(t.cells[1].width as i64, a + b - half, "{name}");
+
+        for (p, before) in above.iter().zip(widths_above) {
+            let now: Vec<_> = table(&doc, para, p).cells.iter().map(|c| c.width).collect();
+            assert_eq!(now, before, "{name}: a table above keeps its widths");
+        }
+        survives_saving(&doc, para, &path, name);
+    }
