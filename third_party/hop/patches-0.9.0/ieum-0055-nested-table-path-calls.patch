+/// A rectangle (not a table) put in a cell paragraph; returns its control index there.
+fn put_rectangle(paragraph: &mut Paragraph) -> usize {
+    use crate::model::shape::{RectangleShape, ShapeObject};
+    paragraph
+        .controls
+        .push(Control::Shape(Box::new(ShapeObject::Rectangle(
+            RectangleShape::default(),
+        ))));
+    paragraph.controls.len() - 1
+}
