+fn refused_writes(doc: &mut DocumentCore, para: usize, path: &Path, why: &str) {
+    let before = snapshot(doc);
+    for (name, call) in writes() {
+        assert!(call(doc, para, path).is_err(), "{why}: {name} is refused");
+        assert_eq!(snapshot(doc), before, "{why}: {name} changes nothing");
+    }
+}
+
+/// The stored line of a treat-as-char table's cell paragraph holds the table, as in a file
+/// Hangul wrote: (line text height, outer table band, vpos of the next cell paragraph).
+fn host_line(doc: &DocumentCore, para: usize, path: &Path) -> (i64, i64, Option<i32>) {
+    let (steps, control) = path.split_at(path.len() - 1);
+    let host_idx = steps.last().unwrap().2;
+    let paragraphs = {
+        let outer = &doc.document().sections[0].paragraphs[para];
+        let container = super::host_paragraph(outer, &steps[..steps.len() - 1]).unwrap();
+        let (c, cell, _) = *steps.last().unwrap();
+        match &container.controls[c] {
+            Control::Table(t) => &t.cells[cell].paragraphs,
+            Control::Shape(s) => {
+                &crate::document_core::helpers::get_textbox_at(s, cell)
+                    .unwrap()
+                    .paragraphs
+            }
+            _ => unreachable!(),
+        }
+    };
+    let p = &paragraphs[host_idx];
+    let Control::Table(t) = &p.controls[control[0].0] else {
+        panic!("table");
+    };
+    let band = i64::from(t.common.height)
+        + i64::from(t.outer_margin_top)
+        + i64::from(t.outer_margin_bottom);
+    let row = crate::renderer::layout::control_line_seg_index(p, control[0].0).expect("row");
+    (
+        i64::from(p.line_segs[row].text_height),
+        band,
+        paragraphs
+            .get(host_idx + 1)
+            .and_then(|n| n.line_segs.first())
+            .map(|s| s.vertical_pos),
+    )
+}
+
+#[test]
+fn a_taller_tac_table_moves_its_cell_line_and_what_follows() {
+    for depth in 1..=3 {
+        let (doc, para, tables) = nested(depth);
+        // saved and reopened, the cell lines hold the tables. A table the engine made marks
+        // its line as computed; Hangul's files do not (nested-form.hwp), so clear the mark.
+        let mut doc = reopened(&doc.export_hwp_native().unwrap());
+        let path = tables[depth].clone();
+        let row = {
+            let outer = &mut doc.document.sections[0].paragraphs[para];
+            let host = super::host_paragraph_mut(outer, &path[..depth]).unwrap();
+            let row = crate::renderer::layout::control_line_seg_index(host, path[depth].0).unwrap();
+            host.line_segs[row].tag &=
+                !crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY;
+            row
+        };
+        assert_eq!(row, 0);
+        let (line, band, next) = host_line(&doc, para, &path);
+        assert_eq!(line, band, "depth {depth}: the stored line holds the table");
+        let next = next.expect("a paragraph after the table in its cell");
+
+        doc.insert_table_row_by_path_native(0, para, &path, 1, true)
+            .unwrap();
+        let (line, band_after, next_after) = host_line(&doc, para, &path);
+        let grown = band_after - band;
+        assert!(grown > 0, "depth {depth}: the table grows by the row");
+        assert_eq!(
+            line, band_after,
+            "depth {depth}: the stored line grows with it"
+        );
+        assert_eq!(
+            i64::from(next_after.unwrap()),
+            i64::from(next) + grown,
+            "depth {depth}: the next paragraph moves"
+        );
+        let verify = doc.serialize_hwp_with_verify().unwrap();
+        assert_eq!(
+            verify.page_count_before, verify.page_count_after,
+            "depth {depth}"
+        );
+
+        doc.delete_table_row_by_path_native(0, para, &path, 2)
+            .unwrap();
+        let (line, band_back, next_back) = host_line(&doc, para, &path);
+        assert_eq!(
+            (line, band_back, next_back),
+            (band, band, Some(next)),
+            "depth {depth}: back"
+        );
+    }
+}
