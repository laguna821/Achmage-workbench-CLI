+type Call = fn(&mut DocumentCore, usize, &Path) -> Result<String, crate::error::HwpError>;
+
+/// Every writing call, with arguments that would succeed on a 2×2 table.
+fn writes() -> Vec<(&'static str, Call)> {
+    vec![
+        ("insert row", |d, p, path| {
+            d.insert_table_row_by_path_native(0, p, path, 0, true)
+        }),
+        ("insert column", |d, p, path| {
+            d.insert_table_column_by_path_native(0, p, path, 0, true)
+        }),
+        ("delete row", |d, p, path| {
+            d.delete_table_row_by_path_native(0, p, path, 0)
+        }),
+        ("delete column", |d, p, path| {
+            d.delete_table_column_by_path_native(0, p, path, 0)
+        }),
+        ("merge", |d, p, path| {
+            d.merge_table_cells_by_path_native(0, p, path, 0, 0, 0, 1)
+        }),
+        ("split", |d, p, path| {
+            d.split_table_cell_into_by_path_native(0, p, path, 0, 0, 2, 1, false, false)
+        }),
+        ("split range", |d, p, path| {
+            d.split_table_cells_in_range_by_path_native(0, p, path, 0, 0, 1, 1, 2, 1, false)
+        }),
+        ("cell properties", |d, p, path| {
+            d.set_cell_properties_by_path_native(0, p, path, 0, r#"{"verticalAlign":1}"#)
+        }),
+        ("zone", |d, p, path| {
+            d.set_cell_zone_properties_by_path_native(
+                0,
+                p,
+                path,
+                0,
+                0,
+                1,
+                1,
+                r#"{"fillType":"none"}"#,
+            )
+        }),
+        ("border fill ids", |d, p, path| {
+            d.apply_cell_border_fill_ids_by_path_native(
+                0,
+                p,
+                path,
+                r#"{"cells":[{"cellIdx":0,"id":1}]}"#,
+            )
+        }),
+        ("table properties", |d, p, path| {
+            d.set_table_properties_by_path_native(0, p, path, r#"{"cellSpacing":5}"#)
+        }),
+        ("resize", |d, p, path| {
+            d.resize_table_cell_by_path_native(0, p, path, 0, 0, false, true)
+        }),
+        ("extents", |d, p, path| {
+            d.set_table_cell_extents_by_path_native(
+                0,
+                p,
+                path,
+                false,
+                r#"[{"cellIdx":0,"start":0,"end":3000}]"#,
+            )
+        }),
+    ]
+}
+
+fn refused(doc: &mut DocumentCore, para: usize, path: &Path, why: &str) {
+    let before = snapshot(doc);
+    for (name, call) in writes() {
+        assert!(call(doc, para, path).is_err(), "{why}: {name} is refused");
+        assert_eq!(snapshot(doc), before, "{why}: {name} changes nothing");
+    }
+    assert!(
+        doc.get_table_properties_by_path_native(0, para, path)
+            .is_err(),
+        "{why}: read"
+    );
+    assert!(
+        doc.get_cell_own_properties_by_path_native(0, para, path, 0)
+            .is_err(),
+        "{why}: read cell"
+    );
+}
