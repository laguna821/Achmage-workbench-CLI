+#[test]
+fn a_wrong_path_changes_nothing() {
+    let (mut doc, para, tables) = nested(2);
+    let inner = tables[2].clone();
+    refused(&mut doc, para, &Vec::new(), "empty path");
+    let mut out_of_range = inner.clone();
+    out_of_range[1].1 = 9; // no cell 9 in the middle table
+    refused(&mut doc, para, &out_of_range, "cell out of range");
+    let mut no_paragraph = inner.clone();
+    no_paragraph[0].2 = 9;
+    refused(&mut doc, para, &no_paragraph, "paragraph out of range");
+    let mut no_control = inner.clone();
+    no_control[2].0 = 7;
+    refused(&mut doc, para, &no_control, "control out of range");
+    refused(&mut doc, para + 5, &inner, "body paragraph out of range");
+    // the last step names a rectangle in the innermost table's second cell
+    let rectangle = {
+        let outer = &mut doc.document.sections[0].paragraphs[para];
+        let host = super::host_paragraph_mut(outer, &inner[..2]).unwrap();
+        let Control::Table(t) = &mut host.controls[inner[2].0] else {
+            panic!("table");
+        };
+        put_rectangle(&mut t.cells[1].paragraphs[0])
+    };
+    let mut not_a_table = inner.clone();
+    not_a_table[2] = (inner[2].0, 1, 0);
+    not_a_table.push((rectangle, 0, 0));
+    refused(&mut doc, para, &not_a_table, "not a table");
+    // a step through a rectangle
+    let mut through_shape = not_a_table.clone();
+    through_shape.push((0, 0, 0));
+    refused(
+        &mut doc,
+        para,
+        &through_shape,
+        "through a shape without a text box",
+    );
+
+    // a text box after the first step: the text box (holding its table) put in a body
+    // table's cell
+    let (mut boxed, box_para, box_path) = text_box_table();
+    let shape = boxed.document.sections[0].paragraphs[box_para].controls[box_path[0].0].clone();
+    let (body_para, body_control) = boxed.document.sections[0]
+        .paragraphs
+        .iter()
+        .enumerate()
+        .find_map(|(i, p)| {
+            p.controls
+                .iter()
+                .position(|c| matches!(c, Control::Table(_)))
+                .map(|c| (i, c))
+        })
+        .expect("the body table");
+    let Control::Table(body) =
+        &mut boxed.document.sections[0].paragraphs[body_para].controls[body_control]
+    else {
+        unreachable!()
+    };
+    body.cells[0].paragraphs[0].controls.push(shape);
+    let in_cell_box = body.cells[0].paragraphs[0].controls.len() - 1;
+    let deeper = vec![
+        (body_control, 0, 0),
+        (in_cell_box, box_path[0].1, box_path[0].2),
+        box_path[1],
+    ];
+    // the read side resolver would follow it; the path calls do not
+    assert!(boxed.resolve_table_by_path(0, body_para, &deeper).is_ok());
+    refused(&mut boxed, body_para, &deeper, "a text box inside a cell");
+}
