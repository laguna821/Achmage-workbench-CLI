+#[test]
+fn row_and_column_edits_change_only_the_named_table() {
+    for (name, mut doc, para, path, above) in cases() {
+        let parents: Vec<_> = above.iter().map(|p| dims(&doc, para, p)).collect();
+        // the cells of every table above, except the one the path goes through
+        let neighbours: Vec<_> = above
+            .iter()
+            .zip(above.iter().skip(1).chain(std::iter::once(&path)))
+            .map(|(p, below)| {
+                let through = below[p.len() - 1].1;
+                cells_but(&doc, para, p, through)
+            })
+            .collect();
+
+        let answer = json(
+            &doc.insert_table_row_by_path_native(0, para, &path, 0, true)
+                .expect("row"),
+        );
+        assert_eq!(
+            (answer["rowCount"].as_u64(), answer["colCount"].as_u64()),
+            (Some(3), Some(2)),
+            "{name}"
+        );
+        assert_eq!(
+            dims(&doc, para, &path),
+            (3, 2, 6),
+            "{name}: a row below the first"
+        );
+        let answer = json(
+            &doc.insert_table_column_by_path_native(0, para, &path, 1, true)
+                .expect("column"),
+        );
+        assert_eq!(
+            (answer["rowCount"].as_u64(), answer["colCount"].as_u64()),
+            (Some(3), Some(3)),
+            "{name}"
+        );
+        survives_saving(&doc, para, &path, name);
+        doc.delete_table_column_by_path_native(0, para, &path, 0)
+            .expect("delete column");
+        doc.delete_table_row_by_path_native(0, para, &path, 2)
+            .expect("delete row");
+        assert_eq!(dims(&doc, para, &path), (2, 2, 4), "{name}: back to 2×2");
+
+        for (p, before) in above.iter().zip(parents) {
+            assert_eq!(
+                dims(&doc, para, p),
+                before,
+                "{name}: a table above keeps its grid"
+            );
+        }
+        for ((p, below), before) in above
+            .iter()
+            .zip(above.iter().skip(1).chain(std::iter::once(&path)))
+            .zip(neighbours)
+        {
+            let through = below[p.len() - 1].1;
+            assert_eq!(
+                cells_but(&doc, para, p, through),
+                before,
+                "{name}: neighbour cells"
+            );
+        }
+        survives_saving(&doc, para, &path, name);
+    }
+}
