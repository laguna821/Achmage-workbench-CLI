+//! The cell-path table calls on a table in a table (one to three levels down) and in a text
+//! box: each edits that table only, a wrong path changes nothing, and the saved files reopen
+//! with the edited structure and the same page count.
+use crate::document_core::DocumentCore;
+use crate::model::control::Control;
+use crate::model::paragraph::Paragraph;
+use crate::model::table::Table;
+use serde_json::Value;
+
+type Path = Vec<(usize, usize, usize)>;
+
+fn json(s: &str) -> Value {
+    serde_json::from_str(s).expect("json answer")
+}
+
+fn path_of(answer: &Value) -> Path {
+    answer["cellPath"]
+        .as_array()
+        .expect("cellPath")
+        .iter()
+        .map(|e| {
+            let n = |k: &str| e[k].as_u64().expect("path number") as usize;
+            (n("controlIndex"), n("cellIndex"), n("cellParaIndex"))
+        })
+        .collect()
+}
+
+/// The path to cell `cell`, paragraph `para` of the table `table` names.
+fn in_cell(table: &Path, cell: usize, para: usize) -> Path {
+    let mut path = table.clone();
+    let last = path.last_mut().expect("path");
+    *last = (last.0, cell, para);
+    path
+}
+
+/// Body: "before", a 2×2 treat-as-char table, "after". Then `depth` tables, each a 2×2
+/// treat-as-char table in the first cell of the one above. Every table's last cell holds its
+/// level as text. Returns the document, the table's body paragraph and the path of every
+/// table, outermost first.
+fn nested(depth: usize) -> (DocumentCore, usize, Vec<Path>) {
+    let mut doc = DocumentCore::new_empty();
+    doc.create_blank_document_native().expect("blank");
+    doc.insert_text_native(0, 0, 0, "before").expect("type");
+    doc.split_paragraph_native(0, 0, 6, None).expect("split");
+    doc.split_paragraph_native(0, 1, 0, None).expect("split");
+    doc.insert_text_native(0, 2, 0, "after").expect("type");
+    let made = json(
+        &doc.create_table_ex_native(0, 1, 0, 2, 2, true, None, None)
+            .expect("outer table"),
+    );
+    let para = made["paraIdx"].as_u64().expect("para") as usize;
+    let control = made["controlIdx"].as_u64().expect("control") as usize;
+    let mut tables = vec![vec![(control, 0, 0)]];
+    for _ in 0..depth {
+        let above = tables.last().expect("table").clone();
+        let answer = json(
+            &doc.create_table_in_cell_by_path_native(
+                0,
+                para,
+                &in_cell(&above, 0, 0),
+                0,
+                2,
+                2,
+                None,
+                None,
+                true,
+            )
+            .expect("nested table"),
+        );
+        tables.push(path_of(&answer));
+    }
+    for (level, table) in tables.iter().enumerate() {
+        doc.insert_text_in_cell_by_path(0, para, &in_cell(table, 3, 0), 0, &level.to_string())
+            .expect("cell text");
+    }
+    (doc, para, tables)
+}
+
+/// A body text box holding a 2×2 table (pasted, as the editor does), and a body table after
+/// it. Returns the document, the text box's paragraph and the path of the table in it.
+fn text_box_table() -> (DocumentCore, usize, Path) {
+    let mut doc = DocumentCore::new_empty();
+    doc.create_blank_document_native().expect("blank");
+    doc.insert_text_native(0, 0, 0, "body").expect("type");
+    doc.split_paragraph_native(0, 0, 4, None).expect("split");
+    let body = json(
+        &doc.create_table_ex_native(0, 1, 0, 2, 2, true, None, None)
+            .expect("body table"),
+    );
+    let (body_para, body_control) = (
+        body["paraIdx"].as_u64().unwrap() as usize,
+        body["controlIdx"].as_u64().unwrap() as usize,
+    );
+    doc.insert_text_in_cell_by_path(0, body_para, &[(body_control, 3, 0)], 0, "body cell")
+        .expect("type");
+    let shape = json(
+        &doc.create_shape_control_native(
+            0,
+            0,
+            4,
+            30000,
+            12000,
+            0,
+            0,
+            false,
+            "Square",
+            "textbox",
+            false,
+            false,
+            &[],
+        )
+        .expect("text box"),
+    );
+    let (para, shape_control) = (
+        shape["paraIdx"].as_u64().unwrap() as usize,
+        shape["controlIdx"].as_u64().unwrap() as usize,
+    );
+    doc.copy_control_native(0, body_para, &[], body_control)
+        .expect("copy");
+    let pasted = json(
+        &doc.paste_internal_in_cell_by_path_native(0, para, &[(shape_control, 0, 0)], 0)
+            .expect("paste into the text box"),
+    );
+    let box_para = pasted["cellParaIdx"].as_u64().unwrap() as usize;
+    let paragraph = &doc.document().sections[0].paragraphs[para];
+    let Control::Shape(shape) = &paragraph.controls[shape_control] else {
+        panic!("text box");
+    };
+    let text_box = crate::document_core::helpers::get_textbox_at(shape, 0).expect("text box");
+    let table_control = text_box.paragraphs[box_para]
+        .controls
+        .iter()
+        .position(|c| matches!(c, Control::Table(_)))
+        .expect("the table in the text box");
+    (
+        doc,
+        para,
+        vec![(shape_control, 0, box_para), (table_control, 0, 0)],
+    )
+}
+
+fn host<'a>(doc: &'a DocumentCore, para: usize, path: &Path) -> &'a Paragraph {
+    let outer = &doc.document().sections[0].paragraphs[para];
+    super::host_paragraph(outer, &path[..path.len() - 1]).expect("host paragraph")
+}
+
+fn table<'a>(doc: &'a DocumentCore, para: usize, path: &Path) -> &'a Table {
+    match &host(doc, para, path).controls[path.last().unwrap().0] {
+        Control::Table(table) => table,
+        _ => panic!("not a table"),
+    }
+}
+
+fn dims(doc: &DocumentCore, para: usize, path: &Path) -> (u16, u16, usize) {
+    let t = table(doc, para, path);
+    (t.row_count, t.col_count, t.cells.len())
+}
+
+/// The whole section as text, to compare before and after a refused call.
+fn snapshot(doc: &DocumentCore) -> String {
+    format!("{:?}", doc.document().sections)
+}
+
+/// Every cell of `path`'s table but `except`, as text.
+fn cells_but(doc: &DocumentCore, para: usize, path: &Path, except: usize) -> Vec<String> {
+    table(doc, para, path)
+        .cells
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| *i != except)
+        .map(|(_, c)| format!("{:?}", c))
+        .collect()
+}
+
+/// Paths of every nested table the tests run on: one, two and three levels down and in a
+/// text box. (document, body paragraph, table path, paths of the tables above it)
+fn cases() -> Vec<(&'static str, DocumentCore, usize, Path, Vec<Path>)> {
+    let mut out = Vec::new();
+    for depth in 1..=3 {
+        let (doc, para, tables) = nested(depth);
+        let target = tables[depth].clone();
+        let above = tables[..depth].to_vec();
+        out.push((
+            ["depth 1", "depth 2", "depth 3"][depth - 1],
+            doc,
+            para,
+            target,
+            above,
+        ));
+    }
+    let (doc, para, path) = text_box_table();
+    out.push(("text box", doc, para, path, Vec::new()));
+    out
+}
+
+fn reopened(bytes: &[u8]) -> DocumentCore {
+    DocumentCore::from_bytes(bytes).expect("reopen")
+}
+
+/// Saves as .hwp and .hwpx, reopens and checks the table's grid and the page count.
+fn survives_saving(doc: &DocumentCore, para: usize, path: &Path, name: &str) {
+    let want = dims(doc, para, path);
+    let verify = doc.serialize_hwp_with_verify().expect("hwp verify");
+    assert_eq!(
+        verify.page_count_before, verify.page_count_after,
+        "{name}: .hwp reopens with the edited page count"
+    );
+    for bytes in [
+        doc.export_hwp_native().expect("hwp"),
+        doc.export_hwpx_native().expect("hwpx"),
+    ] {
+        let again = reopened(&bytes);
+        assert_eq!(dims(&again, para, path), want, "{name}: the reopened grid");
+        assert_eq!(
+            again.page_count(),
+            doc.page_count(),
+            "{name}: reopened page count"
+        );
+    }
+}
