@@ -0,0 +1,875 @@
+//! Cell-path forms of the flat table calls (`insertTableRowByPath` and the rest).
+//!
+//! The flat calls of `table_ops.rs` reach a table as `(section, paragraph, control)`, so only
+//! a table in the body. These take the same cell path as the other `*_by_path` calls,
+//! `[(control, cell, cell paragraph), …]`, and edit the table its last step names. A path
+//! of one step is a body table and goes to the flat call unchanged. Every step before the
+//! last enters a table cell; the first may enter a text box instead (the path the editor's
+//! cursor uses there). A text box later in the path, a step that is out of range or not a
+//! table, and a table whose borders are drawn by objects are refused before anything changes.
+//!
+//! The edit itself is the flat call's model part, run while the paragraph that holds the
+//! table stands in the body paragraph's slot (`with_nested_table`). When a treat-as-char
+//! table changes height, the stored line of its paragraph and the following paragraphs of
+//! the same cell move by the difference, the rule patch 0042 keeps for a body table.
+use super::border_paint_structure::{table_has_border_paint, StructureEdit};
+use crate::document_core::helpers::{get_textbox_at, get_textbox_at_mut};
+use crate::document_core::tac_host_rows::move_host_row;
+use crate::document_core::DocumentCore;
+use crate::error::HwpError;
+use crate::model::control::Control;
+use crate::model::event::DocumentEvent;
+use crate::model::paragraph::Paragraph;
+use crate::model::table::Table;
+
+type CellPath = [(usize, usize, usize)];
+
+const DRAWN_BORDERS: &str = "칸 테두리를 개체로 그린 안쪽 표는 아직 고칠 수 없습니다";
+const CAPTION: &str = "안쪽 표의 캡션은 아직 넣거나 고칠 수 없습니다";
+
+fn error(message: impl Into<String>) -> HwpError {
+    HwpError::RenderError(message.into())
+}
+
+/// The steps to the paragraph that holds the table, and the table's control index.
+fn split_path(path: &CellPath) -> Result<(&CellPath, usize), HwpError> {
+    let (&(control_idx, _, _), steps) = path
+        .split_last()
+        .ok_or_else(|| error("경로가 비어있습니다"))?;
+    Ok((steps, control_idx))
+}
+
+/// The container a step enters: a table cell, or a text box when it is the first step.
+fn step_error(i: usize, control: Option<&Control>, control_idx: usize) -> HwpError {
+    match control {
+        None => error(format!("경로[{}]: controls[{}] 범위 초과", i, control_idx)),
+        Some(Control::Shape(_)) if i > 0 => error(format!(
+            "경로[{}]: 표 칸 안의 글상자에 든 표는 고칠 수 없습니다",
+            i
+        )),
+        Some(Control::Shape(_)) => error(format!(
+            "경로[{}]: controls[{}] 개체에 글상자가 없습니다",
+            i, control_idx
+        )),
+        Some(_) => error(format!(
+            "경로[{}]: controls[{}]가 표나 글상자가 아닙니다",
+            i, control_idx
+        )),
+    }
+}
+
+fn paragraph_error(i: usize, cell_para_idx: usize, count: usize) -> HwpError {
+    error(format!(
+        "경로[{}]: 문단 {} 범위 초과 (총 {}개)",
+        i, cell_para_idx, count
+    ))
+}
+
+/// The paragraph `steps` lead to from `outer`.
+fn host_paragraph<'a>(outer: &'a Paragraph, steps: &CellPath) -> Result<&'a Paragraph, HwpError> {
+    let mut para = outer;
+    for (i, &(control_idx, cell_idx, cell_para_idx)) in steps.iter().enumerate() {
+        let control = para.controls.get(control_idx);
+        let paragraphs = match control {
+            Some(Control::Table(table)) => {
+                &table
+                    .cells
+                    .get(cell_idx)
+                    .ok_or_else(|| {
+                        error(format!(
+                            "경로[{}]: 셀 {} 범위 초과 (총 {}개)",
+                            i,
+                            cell_idx,
+                            table.cells.len()
+                        ))
+                    })?
+                    .paragraphs
+            }
+            Some(Control::Shape(shape)) if i == 0 => {
+                &get_textbox_at(shape, cell_idx)
+                    .ok_or_else(|| step_error(i, control, control_idx))?
+                    .paragraphs
+            }
+            _ => return Err(step_error(i, control, control_idx)),
+        };
+        para = paragraphs
+            .get(cell_para_idx)
+            .ok_or_else(|| paragraph_error(i, cell_para_idx, paragraphs.len()))?;
+    }
+    Ok(para)
+}
+
+/// `host_paragraph` for writing. Only called on a path `host_paragraph` accepted.
+fn host_paragraph_mut<'a>(
+    outer: &'a mut Paragraph,
+    steps: &CellPath,
+) -> Result<&'a mut Paragraph, HwpError> {
+    let mut para = outer;
+    for (i, &(control_idx, cell_idx, cell_para_idx)) in steps.iter().enumerate() {
+        let paragraphs = match para.controls.get_mut(control_idx) {
+            Some(Control::Table(table)) => {
+                &mut table
+                    .cells
+                    .get_mut(cell_idx)
+                    .ok_or_else(|| error(format!("경로[{}]: 셀 {} 범위 초과", i, cell_idx)))?
+                    .paragraphs
+            }
+            Some(Control::Shape(shape)) if i == 0 => {
+                &mut get_textbox_at_mut(shape, cell_idx)
+                    .ok_or_else(|| error(format!("경로[{}]: 글상자가 없습니다", i)))?
+                    .paragraphs
+            }
+            _ => return Err(error(format!("경로[{}]: 표나 글상자가 아닙니다", i))),
+        };
+        let count = paragraphs.len();
+        para = paragraphs
+            .get_mut(cell_para_idx)
+            .ok_or_else(|| paragraph_error(i, cell_para_idx, count))?;
+    }
+    Ok(para)
+}
+
+/// Height of a treat-as-char table without a caption, the tables whose stored line follows it.
+fn tac_height(table: &Table) -> Option<i64> {
+    (table.common.treat_as_char && table.caption.is_none()).then(|| i64::from(table.common.height))
+}
+
+/// The JSON object of `set_table_properties_by_path_native` without its caption keys. A
+/// nested table's caption is not edited yet: a value that would add, remove or change the
+/// caption is refused, and the dialog's unchanged values are dropped.
+fn without_caption_keys(json: &str, table: &Table) -> Result<String, HwpError> {
+    use crate::model::shape::{CaptionDirection, CaptionVertAlign};
+    let serde_json::Value::Object(mut obj) =
+        serde_json::from_str(json).map_err(|e| error(format!("표 속성 JSON 파싱 실패: {}", e)))?
+    else {
+        return Err(error("표 속성은 JSON 객체여야 합니다"));
+    };
+    if let Some(has) = obj.remove("hasCaption") {
+        if has
+            .as_bool()
+            .is_some_and(|has| has != table.caption.is_some())
+        {
+            return Err(error(CAPTION));
+        }
+    }
+    let int = |obj: &serde_json::Map<String, serde_json::Value>, key: &str| {
+        obj.get(key).and_then(|v| v.as_i64())
+    };
+    if let Some(cap) = &table.caption {
+        let unchanged = [
+            int(&obj, "captionDirection").is_none_or(|v| {
+                let wanted = match v {
+                    0 => CaptionDirection::Left,
+                    1 => CaptionDirection::Right,
+                    2 => CaptionDirection::Top,
+                    _ => CaptionDirection::Bottom,
+                };
+                wanted == cap.direction
+            }),
+            int(&obj, "captionSpacing").is_none_or(|v| v == i64::from(cap.spacing)),
+            int(&obj, "captionWidth").is_none_or(|v| v == i64::from(cap.width)),
+            int(&obj, "captionVertAlign").is_none_or(|v| {
+                let wanted = match v {
+                    1 => CaptionVertAlign::Center,
+                    2 => CaptionVertAlign::Bottom,
+                    _ => CaptionVertAlign::Top,
+                };
+                wanted == cap.vert_align
+            }),
+        ];
+        if unchanged.contains(&false) {
+            return Err(error(CAPTION));
+        }
+    }
+    for key in [
+        "captionDirection",
+        "captionSpacing",
+        "captionWidth",
+        "captionVertAlign",
+    ] {
+        obj.remove(key);
+    }
+    Ok(serde_json::Value::Object(obj).to_string())
+}
+
+impl DocumentCore {
+    /// The paragraph holding the table a nested path names, and the table's control index.
+    fn nested_table_host(
+        &self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+    ) -> Result<(&Paragraph, usize), HwpError> {
+        let (steps, control_idx) = split_path(path)?;
+        let outer = self
+            .document
+            .sections
+            .get(section_idx)
+            .ok_or_else(|| error(format!("구역 {} 범위 초과", section_idx)))?
+            .paragraphs
+            .get(parent_para_idx)
+            .ok_or_else(|| error(format!("문단 {} 범위 초과", parent_para_idx)))?;
+        let host = host_paragraph(outer, steps)?;
+        match host.controls.get(control_idx) {
+            Some(Control::Table(_)) => Ok((host, control_idx)),
+            Some(_) => Err(error(format!(
+                "경로[{}]: controls[{}]가 표가 아닙니다",
+                steps.len(),
+                control_idx
+            ))),
+            None => Err(error(format!(
+                "경로[{}]: controls[{}] 범위 초과",
+                steps.len(),
+                control_idx
+            ))),
+        }
+    }
+
+    fn nested_table(
+        &self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+    ) -> Result<&Table, HwpError> {
+        let (host, control_idx) = self.nested_table_host(section_idx, parent_para_idx, path)?;
+        match &host.controls[control_idx] {
+            Control::Table(table) => Ok(table),
+            _ => unreachable!("nested_table_host checked the table"),
+        }
+    }
+
+    /// Runs `edit(self, control)` on the nested table the path names. Meanwhile the paragraph
+    /// that holds the table stands in the body paragraph's slot, so the flat calls' model
+    /// parts address it as `(section, parent paragraph, control)`. The path is checked first
+    /// and nothing changes when it is wrong. Afterwards a treat-as-char table's new height
+    /// moves its stored line (0042's rule for the paragraphs of its cell or text box).
+    fn with_nested_table<R>(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+        edit: impl FnOnce(&mut Self, usize) -> Result<R, HwpError>,
+    ) -> Result<R, HwpError> {
+        let (host, control_idx) = self.nested_table_host(section_idx, parent_para_idx, path)?;
+        if table_has_border_paint(host, control_idx) {
+            return Err(error(DRAWN_BORDERS));
+        }
+        let declared = match &host.controls[control_idx] {
+            Control::Table(table) => tac_height(table),
+            _ => None,
+        };
+        let (steps, _) = split_path(path)?;
+
+        let paragraphs = &mut self.document.sections[section_idx].paragraphs;
+        let mut outer = std::mem::take(&mut paragraphs[parent_para_idx]);
+        let host = match host_paragraph_mut(&mut outer, steps) {
+            Ok(host) => std::mem::take(host),
+            Err(e) => {
+                paragraphs[parent_para_idx] = outer;
+                return Err(e);
+            }
+        };
+        paragraphs[parent_para_idx] = host;
+        let result = edit(self, control_idx);
+        let paragraphs = &mut self.document.sections[section_idx].paragraphs;
+        let host = std::mem::replace(&mut paragraphs[parent_para_idx], outer);
+        // The outer paragraph was out of the document during the edit, so the steps that led
+        // to the host still lead to its empty place.
+        *host_paragraph_mut(&mut paragraphs[parent_para_idx], steps)
+            .expect("the outer paragraph keeps its shape while the host is out") = host;
+        let value = result?;
+
+        if let Some(declared) = declared {
+            self.move_nested_tac_host_row(section_idx, parent_para_idx, path, declared);
+        }
+        Ok(value)
+    }
+
+    /// 0042 for a nested table: when the treat-as-char table changed height from `declared`,
+    /// its stored line and the following paragraphs of the same container move with it.
+    fn move_nested_tac_host_row(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+        declared: i64,
+    ) {
+        let Ok((steps, control_idx)) = split_path(path) else {
+            return;
+        };
+        let Some(&(_, _, host_idx)) = steps.last() else {
+            return;
+        };
+        let Ok(paragraphs) =
+            self.get_cell_paragraphs_mut_by_path(section_idx, parent_para_idx, steps)
+        else {
+            return;
+        };
+        let content = match paragraphs
+            .get(host_idx)
+            .and_then(|para| para.controls.get(control_idx))
+        {
+            Some(Control::Table(table)) => i64::from(table.common.height),
+            _ => return,
+        };
+        if content != declared {
+            move_host_row(paragraphs, host_idx, control_idx, declared, content);
+        }
+    }
+
+    /// The body paragraph holding the nested table needs layout again. The caller has
+    /// invalidated the section's source bytes (`raw_stream`).
+    fn finish_nested_table_edit(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+    ) {
+        let (outer_control, outer_cell, _) = path[0];
+        self.mark_cell_control_dirty(section_idx, parent_para_idx, outer_control);
+        self.recompose_section_at_batch_end(section_idx, &[parent_para_idx]);
+        self.paginate_if_needed();
+        self.event_log.push(DocumentEvent::CellTextChanged {
+            section: section_idx,
+            para: parent_para_idx,
+            ctrl: outer_control,
+            cell: outer_cell,
+        });
+    }
+
+    /// The answer of a row or column edit on a nested table; the caller finishes the edit.
+    fn nested_structure_edit(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+        edit: StructureEdit,
+    ) -> Result<String, HwpError> {
+        let (row_count, col_count) =
+            self.with_nested_table(section_idx, parent_para_idx, path, |doc, control_idx| {
+                let table = doc.get_table_mut(section_idx, parent_para_idx, control_idx)?;
+                edit.apply(table, |_, _| {})
+                    .map_err(HwpError::RenderError)?;
+                Ok((table.row_count, table.col_count))
+            })?;
+        Ok(crate::document_core::helpers::json_ok_with(&format!(
+            "\"rowCount\":{},\"colCount\":{}",
+            row_count, col_count
+        )))
+    }
+
+    /// `insert_table_row_native` for the table the cell path names.
+    pub fn insert_table_row_by_path_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &CellPath,
+        row_idx: u16,
+        below: bool,
+    ) -> Result<String, HwpError> {
+        if let [(control_idx, _, _)] = *path {
+            return self.insert_table_row_native(
+                section_idx,
+                parent_para_idx,
+                control_idx,
+                row_idx,
+                below,
+            );
