+        ];
+        let families = ["함초롬바탕", "Noto Sans KR", "맑은 고딕", "없는글꼴"];
+        for family in families {
+            for (bold, italic) in [(false, false), (true, true)] {
+                let style = TextStyle {
+                    font_family: family.to_string(),
+                    font_size: 13.3,
+                    bold,
+                    italic,
+                    letter_spacing: -0.5,
+                    ratio: 0.9,
+                    ..Default::default()
+                };
+                for text in texts {
+                    let traced = trace_char_width_decisions(text, &style);
+                    let decided = char_width_decisions_without_advances(text, &style);
+                    assert_eq!(traced.len(), decided.len());
+                    for (i, ch) in text.chars().enumerate() {
+                        if ch == '\t' {
+                            continue;
+                        }
+                        assert_eq!(
+                            format!("{:?}", traced[i]),
+                            format!("{:?}", decided[i]),
+                            "{family} {ch:?} in {text:?}"
+                        );
+                    }
+                }
+            }
+        }
+    }
