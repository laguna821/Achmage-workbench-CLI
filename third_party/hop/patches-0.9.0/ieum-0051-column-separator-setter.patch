+
+    let page = page(&doc, 0);
+    assert_eq!(page.separators.len(), 1);
+    let (_, top, _) = page.separators[0];
+    let table_bottom = page.table_bottom.expect("the head table is drawn");
+    assert_eq!(page.column_text_tops.len(), 2, "both columns hold text");
+    for text_top in &page.column_text_tops {
+        assert!(
+            (top - text_top).abs() < 0.01,
+            "line {top}, column text {text_top}"
+        );
+    }
+    assert!(
+        (top - (table_bottom + outer_bottom)).abs() < 0.01,
+        "line {top}, table foot {table_bottom}, outer bottom margin {outer_bottom}"
+    );
+}
