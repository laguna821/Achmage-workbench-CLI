+/// What Hancom Hangul 2024 writes in `<hp:colLine type>` when it saves .hwp files holding the
+/// separator codes 1..7 as HWPX. It draws code 2 dashed and code 3 dotted, in the .hwp and in
+/// its own HWPX alike.
+const HANCOM_COL_LINE_NAMES: [(u8, &str); 7] = [
+    (1, "SOLID"),
+    (2, "DOT"),
+    (3, "DASH"),
+    (4, "DASH_DOT"),
+    (5, "DASH_DOT_DOT"),
+    (6, "LONG_DASH"),
+    (7, "CIRCLE"),
+];
+
+fn hancom_col_line(name: &str) -> String {
+    format!(r##"<hp:colLine type="{name}" width="0.2 mm" color="#000000"/>"##)
+}
+
+fn line_of_code(code: u8) -> HwpDocument {
+    let mut doc = blank();
+    fill_lines(&mut doc, 0, 4);
+    doc.set_column_def_native(0, 2, 0, true, EIGHT_MM_COLUMN_GAP)
+        .unwrap();
+    doc.set_column_separator(
+        0,
+        &format!(r##"{{"type":{code},"width":3,"color":"#000000"}}"##),
+    )
+    .unwrap();
+    doc
+}
+
+fn col_line_in(xml: &str) -> &str {
+    let start = xml.find("<hp:colLine").expect("a colLine element");
+    let end = start + xml[start..].find("/>").unwrap() + 2;
+    &xml[start..end]
+}
+
+fn section_xml(hwpx: &[u8]) -> String {
+    let mut zip = zip::ZipArchive::new(Cursor::new(hwpx)).unwrap();
+    let mut xml = String::new();
+    zip.by_name("Contents/section0.xml")
+        .unwrap()
+        .read_to_string(&mut xml)
+        .unwrap();
+    xml
+}
+
+fn with_section_xml(hwpx: &[u8], edit: impl Fn(&str) -> String) -> Vec<u8> {
+    let mut input = zip::ZipArchive::new(Cursor::new(hwpx)).unwrap();
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for i in 0..input.len() {
+        let mut entry = input.by_index(i).unwrap();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).unwrap();
+        let name = entry.name().unwrap().to_string();
+        if name == "Contents/section0.xml" {
+            data = edit(&String::from_utf8(data).unwrap()).into_bytes();
+        }
+        output
+            .start_file(
+                name,
+                zip::write::SimpleFileOptions::default().compression_method(entry.compression()),
+            )
+            .unwrap();
+        output.write_all(&data).unwrap();
+    }
+    output.finish().unwrap().into_inner()
+}
+
+#[test]
+fn hwpx_names_each_line_type_as_hancom_does() {
+    let wrong: Vec<String> = HANCOM_COL_LINE_NAMES
+        .iter()
+        .filter_map(|(code, name)| {
+            let xml = section_xml(&line_of_code(*code).export_hwpx_native().unwrap());
+            let written = col_line_in(&xml).to_string();
+            (written != hancom_col_line(name)).then(|| format!("{code}: {written}"))
+        })
+        .collect();
+    assert!(wrong.is_empty(), "{wrong:#?}");
+}
+
+#[test]
+fn hancoms_hwpx_line_names_read_back_as_the_code_it_draws() {
+    let hwpx = line_of_code(1).export_hwpx_native().unwrap();
+    let wrong: Vec<String> = HANCOM_COL_LINE_NAMES
+        .iter()
+        .filter_map(|(code, name)| {
+            let hancom = with_section_xml(&hwpx, |xml| {
+                xml.replacen(col_line_in(xml), &hancom_col_line(name), 1)
+            });
+            let read = separator_fields(&HwpDocument::from_bytes(&hancom).unwrap()).0;
+            (read != code.to_string())
+                .then(|| format!("{name} read as {read}, Hancom draws {code}"))
+        })
+        .collect();
+    assert!(wrong.is_empty(), "{wrong:#?}");
+}
