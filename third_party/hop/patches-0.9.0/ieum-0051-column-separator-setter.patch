+/// The head of a test paper: a table hung from the top of the page body, pushing the text of
+/// both columns below it, set the way the editor's plugin sets it. Returns the paragraph
+/// after the table's and the table's outer bottom margin in px.
+fn head_table(doc: &mut HwpDocument) -> (usize, f64) {
+    let made = doc.create_table_native(0, 0, 0, 3, 8).unwrap();
+    let para: usize = json_field(&made, "paraIdx").parse().unwrap();
+    let control: u32 = json_field(&made, "controlIdx").parse().unwrap();
+    doc.set_table_properties_native(
+        0,
+        para,
+        control as usize,
+        r#"{"treatAsChar":false,"textWrap":"TopAndBottom","vertRelTo":"Page","horzRelTo":"Page","vertAlign":"Top","horzAlign":"Left","vertOffset":0,"horzOffset":0}"#,
+    )
+    .unwrap();
+    let props = doc.get_table_properties(0, para as u32, control).unwrap();
+    let outer_bottom: f64 = json_field(&props, "outerBottom").parse().unwrap();
+    (para + 1, outer_bottom * 96.0 / 7200.0)
+}
