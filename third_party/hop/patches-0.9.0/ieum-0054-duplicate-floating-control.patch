From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pblsketch <239486537+pblsketch@users.noreply.github.com>
Date: Mon, 16 Nov 2026 00:00:00 +0900
Subject: [PATCH 54/54] feat(object): 떠 있는 그림·도형을 같은 문단에 복제한다
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

한글은 개체를 Ctrl을 누른 채 끌어 놓으면 그 자리에 복사본을 만든다(개체 복사하기/붙이기).
붙이기(`pasteControl`)는 커서 자리에서 문단을 나누고 새 문단을 만들어 개체를 넣으므로,
그 길로는 문단이 둘 늘고 아래 글과 개체가 밀린다.

`duplicateFloatingControl(sec, para, ci, dx, dy)`를 더한다. 본문 문단의 떠 있는 그림·도형을
복제해 같은 문단의 원본 바로 뒤에 넣고 위치를 (dx, dy)HU만큼 옮긴다. 넣는 방법은 그림
넣기의 본문 갈래와 같아(`control_insert_index`, `leave_coordinate_trace`) 문단의 글과 줄
수가 그대로다. 복사본은 붙이기처럼 새 식별자를 받고(`reidentify_clipboard`), 그림은 원본과
같은 이미지 자료를 쓴다. 글자처럼 취급한 개체, 그림·도형이 아닌 컨트롤, 셀·글상자 안의
개체는 거절한다.
---
 .../commands/object_ops/picture.rs            | 87 +++++++++++++++++++
 src/wasm_api.rs                               | 23 +++++
 2 files changed, 110 insertions(+)

diff --git a/src/document_core/commands/object_ops/picture.rs b/src/document_core/commands/object_ops/picture.rs
index d987c534c..8453a0f3d 100644
--- a/src/document_core/commands/object_ops/picture.rs
+++ b/src/document_core/commands/object_ops/picture.rs
@@ -2042,6 +2042,93 @@ impl DocumentCore {
             para_idx, new_ctrl_idx, logical_after
         )))
     }
+
+    /// Copies a floating picture or drawing object of a body paragraph into the same
+    /// paragraph, right after itself, moved by (dx, dy) HWPUNIT: Hangul's Ctrl+drag of an
+    /// object ("개체 복사하기/붙이기"). The copy anchors where the object anchors, so the
+    /// paragraph's text, its line count and the layout around it stay as they were; the
+    /// clipboard paste instead splits the paragraph and adds two. The copy takes fresh
+    /// instance ids, as a pasted control does, and shares the picture's image data.
+    ///
+    /// Returns `{"ok":true,"paraIdx":N,"controlIdx":N}` for the copy. Refuses an object
+    /// placed like a character, any other control, and objects inside cells or text boxes.
+    pub fn duplicate_floating_control_native(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        control_idx: usize,
+        dx: i32,
+        dy: i32,
+    ) -> Result<String, HwpError> {
+        let section = self.document.sections.get(section_idx).ok_or_else(|| {
+            HwpError::RenderError(format!("구역 인덱스 {} 범위 초과", section_idx))
+        })?;
+        let para = section.paragraphs.get(para_idx).ok_or_else(|| {
+            HwpError::RenderError(format!("문단 인덱스 {} 범위 초과", para_idx))
+        })?;
+        let mut copy = match para.controls.get(control_idx) {
+            Some(Control::Picture(picture)) if !picture.common.treat_as_char => {
+                Control::Picture(picture.clone())
+            }
+            Some(Control::Shape(shape)) if !shape.common().treat_as_char => {
+                Control::Shape(shape.clone())
+            }
+            Some(Control::Picture(_)) | Some(Control::Shape(_)) => {
+                return Err(HwpError::RenderError(
+                    "글자처럼 취급한 개체는 복사해 띄울 수 없습니다".to_string(),
+                ))
+            }
+            _ => {
+                return Err(HwpError::RenderError(
+                    "대상 그림·도형을 찾을 수 없습니다".to_string(),
+                ))
+            }
+        };
+        let anchor = crate::document_core::helpers::find_control_text_positions(para)
+            .get(control_idx)
+            .copied()
+            .unwrap_or_else(|| para.text.chars().count());
+
+        // fresh instance ids for the copy and whatever it holds, as a paste gives them
+        let mut staged = Paragraph {
+            controls: vec![copy],
+            ..Default::default()
+        };
+        crate::document_core::commands::clone_identity::reidentify_clipboard(
+            &self.document,
+            std::slice::from_mut(&mut staged),
+        )?;
+        copy = staged.controls.remove(0);
+        let common = match &mut copy {
+            Control::Picture(picture) => &mut picture.common,
+            Control::Shape(shape) => shape.common_mut(),
+            _ => unreachable!("only a picture or a shape is copied"),
+        };
+        common.horizontal_offset = (common.horizontal_offset as i32).wrapping_add(dx) as u32;
+        common.vertical_offset = (common.vertical_offset as i32).wrapping_add(dy) as u32;
+
+        self.document.sections[section_idx].raw_stream = None;
+        let parent = &mut self.document.sections[section_idx].paragraphs[para_idx];
+        // right after the object: the first control past its text position
+        let new_ctrl_idx = Self::control_insert_index(parent, anchor).max(control_idx + 1);
+        parent.align_ctrl_data_records();
+        parent.controls.insert(new_ctrl_idx, copy);
+        parent.ctrl_data_records.insert(new_ctrl_idx, None);
+        Self::leave_coordinate_trace(parent, new_ctrl_idx, anchor);
+        self.shift_active_field_for_control_insert(section_idx, para_idx, new_ctrl_idx);
+
+        self.mark_section_dirty(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        self.event_log.push(DocumentEvent::PictureInserted {
+            section: section_idx,
+            para: para_idx,
+        });
+        Ok(crate::document_core::helpers::json_ok_with(&format!(
+            "\"paraIdx\":{},\"controlIdx\":{}",
+            para_idx, new_ctrl_idx
+        )))
+    }
 }
 
