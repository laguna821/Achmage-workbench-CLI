diff --git a/src/wasm_api.rs b/src/wasm_api.rs
index 265091ce1..80b8efb86 100644
--- a/src/wasm_api.rs
+++ b/src/wasm_api.rs
@@ -5339,6 +5339,29 @@ impl HwpDocument {
         .map_err(|e| e.into())
     }
 
+    /// Copies a floating picture or drawing object of a body paragraph into the same
+    /// paragraph, moved by (dx, dy) HWPUNIT (Hangul's Ctrl+drag of an object). The paragraph
+    /// and the layout around it stay as they were.
+    /// Returns `{"ok":true,"paraIdx":N,"controlIdx":N}` for the copy.
+    #[wasm_bindgen(js_name = duplicateFloatingControl)]
+    pub fn duplicate_floating_control(
+        &mut self,
+        section_idx: u32,
+        para_idx: u32,
+        control_idx: u32,
+        dx: i32,
+        dy: i32,
+    ) -> Result<String, JsValue> {
+        self.duplicate_floating_control_native(
+            section_idx as usize,
+            para_idx as usize,
+            control_idx as usize,
+            dx,
+            dy,
+        )
+        .map_err(|e| e.into())
+    }
+
     /// Shape z-order 변경
     /// operation: "front" | "back" | "forward" | "backward"
     /// 반환: `{"ok":true,"zOrder":N,"moves":[{"ppi","ci","before","after"}...]}`
