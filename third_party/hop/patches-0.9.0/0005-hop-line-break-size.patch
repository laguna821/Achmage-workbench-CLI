+#[cfg(test)]
+mod hop_line_break_size_tests {
+    use super::*;
+
+    /// [HOP patch 0005] "ab " at 10 pt then a 12 pt line break: the first line is a 12 pt line.
+    #[test]
+    fn larger_line_break_raises_its_line() {
+        let text_chars = "ab \ncd".chars().collect::<Vec<_>>();
+        let text = |start_idx: usize| BreakToken::Text {
+            start_idx,
+            end_idx: start_idx + 2,
+            base_width: 20.0,
+            width: 20.0,
+            max_font_size: 10.0,
+            base_char_widths: vec![10.0, 10.0],
+            char_widths: vec![10.0, 10.0],
+        };
+        let tokens = vec![
+            text(0),
+            BreakToken::Space {
+                idx: 2,
+                width: 5.0,
+                condense_base: 5.0,
+                max_font_size: 10.0,
+                inline_width: 0.0,
+            },
+            BreakToken::LineBreak {
+                idx: 3,
+                max_font_size: 12.0,
+            },
+            text(4),
+        ];
+        let mut cursor = FillCursor::new(0, true);
+        let mut filled = Vec::new();
+        while let Some(result) = fill_one_interval(
+            &tokens,
+            &text_chars,
+            200.0,
+            0.0,
+            TabFill::default_only(48.0),
+            0,
+            0,
+            &[],
+            &mut cursor,
+            None,
+        ) {
+            filled.push(result.line);
+        }
+        for lines in [
+            fill_lines_before_cursor(&tokens, &text_chars, 200.0, 0.0, 48.0, 0, 0, 0, true),
+            filled,
+        ] {
+            let sizes: Vec<_> = lines.iter().map(|l| (l.end_idx, l.max_font_size)).collect();
+            assert_eq!(sizes, vec![(4, 12.0), (6, 10.0)]);
+        }
+    }
+}
