+    /// [HOP patch 0011] 탭이 든 양쪽 정렬 줄은 마지막 탭 뒤 공백에만 여분을 나눈다.
+    #[test]
+    fn hop_0011_justify_spreads_only_after_the_last_tab() {
+        let line_of = |texts: &[&str]| ComposedLine {
+            runs: texts
+                .iter()
+                .map(|text| ComposedTextRun {
+                    text: text.to_string(),
+                    ..Default::default()
+                })
+                .collect(),
+            ..split_label_line()
+        };
+        // 마지막 탭까지(가·공백·나·탭 = 4자)는 여분 없음; run 이 나뉘어도 같은 경계.
+        let line = line_of(&["가 나\t다 라"]);
+        assert_eq!(super::hop_last_tab_prefix_by_run(&line, usize::MAX), Some(vec![4]));
+        assert_eq!(
+            super::hop_last_tab_prefix_by_run(&line_of(&["가 ", "나\t다", " 라"]), usize::MAX),
+            Some(vec![2, 2, 0])
+        );
+        assert_eq!(
+            super::hop_last_tab_prefix_by_run(&line_of(&["가\t나 \t다 라 "]), usize::MAX),
+            Some(vec![5]),
+            "마지막 탭 기준, 말미 공백은 매단다"
+        );
+        // 마지막 탭 뒤에 내부 공백이 없으면 종전 배분.
+        assert_eq!(super::hop_last_tab_prefix_by_run(&line_of(&["가 나\t다라 "]), usize::MAX), None);
+        assert_eq!(super::hop_last_tab_prefix_by_run(&line_of(&["가 나 다"]), usize::MAX), None);
+
+        // 슬랙 60px: 마지막 탭 뒤 공백 하나가 전부 받는다(종전: 탭 앞 공백과 반씩).
+        let extra = |prefix: &[usize]| {
+            compute_line_extra_spacing(
+                &line,
+                0,
+                usize::MAX,
+                &LeadingSpacePlan::new(&line, None),
+                0.0,
+                0.0,
+                prefix,
+                &ResolvedStyleSet::default(),
+                None,
+                Alignment::Justify,
+                false,
+                true,
+                false,
+                false,
+                true,
+                false,
+                false,
+                false,
+                7,
+                30.0,
+                90.0,
+                40.0,
+                0,
+            )
+            .0
+        };
+        let hop = super::hop_last_tab_prefix_by_run(&line, usize::MAX).unwrap();
+        assert!((extra(&hop) - 60.0).abs() < 0.001, "hop: {}", extra(&hop));
+        assert!((extra(&[0]) - 30.0).abs() < 0.001, "without: {}", extra(&[0]));
+    }
