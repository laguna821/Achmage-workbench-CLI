+/// [HOP patch 0011] 한글 2024의 탭이 든 양쪽 정렬 줄 [한글 2024 인쇄 결과와 비교]:
+/// 여분은 줄 안 마지막 탭 뒤 공백에만 나누고 탭 앞 공백은 자연 폭이다. 위치는 줄의 그려지는
+/// 텍스트 기준이다. 마지막 탭 뒤에 (말미가 아닌) 공백이 없으면 `None` — 종전 배분을 쓴다.
+/// (0.9.0: expressed through upstream's per-run `unjustified_leading_spaces` prefix, which
+/// both the slack count and the emitted advances already honour, instead of the 0.8.7
+/// `HopTabJustify` / `TextStyle::hop_word_spacing_from` pair. Upstream fixes only the prefix up
+/// to the *first* tab of auto-tab-left hanging lines (`fixed_auto_tab_prefix_by_run`); this
+/// extends it to the last tab of any justified line. Not ported: the 0.8.7 rule that also hangs
+/// trailing tabs past the right margin in sections whose default tab width is 0.)
+fn hop_last_tab_prefix_by_run(line: &ComposedLine, trailing_space_limit: usize) -> Option<Vec<usize>> {
+    let chars: Vec<char> = line
+        .runs
+        .iter()
+        .flat_map(|run| effective_text_for_metrics(run).chars())
+        .collect();
+    let trailing = chars
+        .iter()
+        .rev()
+        .take_while(|c| **c == ' ')
+        .count()
+        .min(trailing_space_limit);
+    let visible = &chars[..chars.len() - trailing];
+    let from = visible.iter().rposition(|c| *c == '\t')? + 1;
+    if !visible[from..].contains(&' ') {
+        return None;
+    }
+    let mut remaining = from;
+    Some(
+        line.runs
+            .iter()
+            .map(|run| {
+                let count = effective_text_for_metrics(run)
+                    .chars()
+                    .count()
+                    .min(remaining);
+                remaining -= count;
+                count
+            })
+            .collect(),
+    )
+}
