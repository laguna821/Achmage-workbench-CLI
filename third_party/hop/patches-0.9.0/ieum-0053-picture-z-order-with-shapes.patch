 use crate::model::paragraph::Paragraph;
 use crate::model::shape::{Caption, CaptionDirection, CaptionVertAlign, ShapeObject};
 
+/// The z order of an object stacked with the others of the section: a drawing object or a
+/// picture. Both draw in one order (plane, z order, path), so ordering one against the other
+/// has to see both.
+fn stacked_z_order(ctrl: &Control) -> Option<i32> {
+    match ctrl {
+        Control::Shape(shape) => Some(shape.z_order()),
+        Control::Picture(picture) => Some(picture.common.z_order),
+        _ => None,
+    }
+}
+
+/// Sets the z order of a drawing object or a picture; false for any other control.
+fn set_stacked_z_order(ctrl: &mut Control, z: i32) -> bool {
+    match ctrl {
+        Control::Shape(shape) => {
+            shape.common_mut().z_order = z;
+            true
+        }
+        Control::Picture(picture) => {
+            picture.common.z_order = z;
+            true
+        }
+        _ => false,
+    }
+}
+
