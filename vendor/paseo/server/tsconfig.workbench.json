{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "files": [
    "src/server/relay-transport.ts",
    "src/server/daemon-keypair.ts",
    "src/server/private-files.ts",
    "src/server/connection-offer.ts",
    "src/server/websocket/secure-relay-ingress.ts",
    "src/server/socket-metadata.ts",
    "src/server/hub/relationship-controller.ts",
    "src/server/hub/relationship-remote.ts",
    "src/server/hub/relationship-retry.ts",
    "src/server/hub/execution-controller.ts",
    "src/server/authorization/index.ts"
  ]
}
