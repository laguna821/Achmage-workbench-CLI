{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "noCheck": true
  },
  "files": [
    "src/index.ts",
    "src/server/index.ts",
    "src/server/provider.ts",
    "src/server/usage.ts",
    "src/server/lifecycle.ts"
  ]
}
