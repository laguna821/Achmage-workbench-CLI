{
  "name": "@getpaseo/client",
  "version": "0.15.3",
  "description": "Paseo client SDK package",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/daemon-client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./internal/daemon-client-transport-types": {
      "types": "./dist/daemon-client-transport-types.d.ts",
      "default": "./dist/daemon-client-transport-types.js"
    },
    "./internal/daemon-client-websocket-transport": {
      "types": "./dist/daemon-client-websocket-transport.d.ts",
      "default": "./dist/daemon-client-websocket-transport.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./internal/hosts": {
      "types": "./dist/hosts/index.d.ts",
      "default": "./dist/hosts/index.js"
    },
    "./internal/daemon-client-transport": {
      "types": "./dist/daemon-client-transport.d.ts",
      "default": "./dist/daemon-client-transport.js"
    },
    "./internal/daemon-client-relay-e2ee-transport": {
      "types": "./dist/daemon-client-relay-e2ee-transport.d.ts",
      "default": "./dist/daemon-client-relay-e2ee-transport.js"
    },
    "./internal/daemon-client-transport-utils": {
      "types": "./dist/daemon-client-transport-utils.d.ts",
      "default": "./dist/daemon-client-transport-utils.js"
    },
    "./internal/compat/reconnect-delay": {
      "types": "./dist/compat/reconnect-delay.d.ts",
      "default": "./dist/compat/reconnect-delay.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build --workspace=@getpaseo/protocol && npm run build --workspace=@getpaseo/relay && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsgo --noEmit",
    "typecheck:examples": "tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "measure:diff-materialization": "tsx scripts/measure-diff-materialization.ts"
  },
  "dependencies": {
    "@getpaseo/protocol": "file:../protocol",
    "@getpaseo/relay": "file:../relay",
    "ws": "8.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  },
  "private": true,
  "x-workbench-vendor-notice": "Original source preserved; private manifest uses local Paseo dependencies and exact upstream-lock runtime pins, with automatic lifecycle hooks removed. See package.upstream.json and source.json. Only selected transport entries are integrated; the complete Paseo SDK facade is not supplied by Workbench."
}
